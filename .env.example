# 阿里云百炼 DashScope API Key（必需）
# 获取地址: https://bailian.console.aliyun.com/
VITE_DASHSCOPE_API_KEY=sk-...

# API 代理地址（可选）
# 如果不配置，将直接请求 dashscope.aliyuncs.com
VITE_API_PROXY_URL=https://dashscope.aliyuncs.com

# AI 模型（可选）
# 默认: deepseek-v4-pro
VITE_API_MODEL=deepseek-v4-pro

# 音乐搜索 API 基地址（可选）
# 用于对接网易云音乐 API 获取可播放音频 URL
# 部署方式: git clone https://github.com/Binaryify/NeteaseCloudMusicApi && node app.js
# 不配置此项时，BGM 推荐仅显示歌名和片段时间，无法试听
# VITE_MUSIC_API_BASE=http://localhost:3000
